#!/usr/bin/env bash
set -euo pipefail
# Reject malformed revision tokens before uv (or any network-capable tool).
previous=''
for argument in "$@"; do
  if [[ "$previous" == '--upstream' || "$previous" == '--controller-rev' || "$previous" == '--accepted-base' || "$previous" == '--candidate-sha' ]]; then
    [[ "$argument" =~ ^[0-9a-f]{40}$ ]] || { printf 'Expected literal full lowercase Git SHA\n' >&2; exit 2; }
  fi
  case "$argument" in
    --upstream=*|--controller-rev=*|--accepted-base=*|--candidate-sha=*)
      value=${argument#*=}
      [[ "$value" =~ ^[0-9a-f]{40}$ ]] || { printf 'Expected literal full lowercase Git SHA\n' >&2; exit 2; } ;;
  esac
  previous=$argument
done
ROOT=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
export TMPDIR="$ROOT/.scratch/tmp"
mkdir -p "$TMPDIR"
case "$(stat -f -c %T "$TMPDIR")" in tmpfs|ramfs) printf 'Disk-backed scratch required\n' >&2; exit 2 ;; esac
export TMP="$TMPDIR" TEMP="$TMPDIR" UV_CACHE_DIR="$ROOT/.scratch/uv-cache"
if [[ ! -x "$ROOT/.scratch/venv/bin/python" ]]; then
  uv venv --python python3 "$ROOT/.scratch/venv" >&2
fi
uv pip sync --python "$ROOT/.scratch/venv/bin/python" --require-hashes "$ROOT/import/requirements.txt" >&2
exec "$ROOT/.scratch/venv/bin/python" "$ROOT/import/pinrail_import.py" "$@"
